{
  "expo": {
    "name": "Mency",
    "slug": "mencyApp",
    "owner": "giucaroline",
    "scheme": "mency",
    "ios": {
      "bundleIdentifier": "com.mency.ios"
    },
    "android": {
      "package": "com.mency.android"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/capaApp.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logoCapaArl.png",
      "resizeMode": "contain",
      "backgroundColor": "#C19200"
    },
    "web": {
      "favicon": "./assets/logoCapaArl.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2aba378b-10ba-44ea-91e1-2f0a2b83c196"
      }
    }
  }
