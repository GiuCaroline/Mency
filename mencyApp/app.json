{
  "expo": {
    "name": "Mency",
    "slug": "mencyApp",
    "scheme": "mency",
    "ios": {
      "bundleIdentifier": "com.mency.ios"
    },
    "android": {
      "package": "com.mency.android"
    },
    "version": "1.0.0",
    "orientation": "portrait", 
    "icon": "./assets/capaApp.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/capaApp.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "favicon": "./assets/capaApp.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps._some_id_here_"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1eb34ef0-3cec-46f3-a133-4bdc21931b6c"
      }
    }
  }
}
